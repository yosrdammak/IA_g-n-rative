# Lancement sans Docker : SQLite par défaut, aucun serveur de base nécessaire.
DATABASE_URL=sqlite:///./smartcampus.db
# Pour utiliser le PostgreSQL du Compose à la place :
# DATABASE_URL=postgresql://smartuser:smartpassword@localhost:5433/smartcampus_DB
JWT_SECRET=local-dev-only-change-this-secret
SEED_DEMO=true
DEMO_PASSWORD=DemoCampus2026!
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Chat provider : "catalogue" (défaut, sans LLM) ou "ollama" (LLM sans RAG)
CHAT_PROVIDER=catalogue
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TIMEOUT=2000

# --- RAG (base de connaissances IIT Sfax) ---
# Prérequis : ollama pull bge-m3 && ollama pull llama3.2:3b
# Copiez le PDF dans backend/data/ ou adaptez le chemin ci-dessous
RAG_PDF_PATH=data/IIT_Sfax_Base_de_connaissances_RAG.pdf
RAG_CHROMA_PATH=chroma_smartcampus
RAG_LLM_MODEL=llama3.2:3b
RAG_EMBED_MODEL=bge-m3
RAG_TOP_K=5
